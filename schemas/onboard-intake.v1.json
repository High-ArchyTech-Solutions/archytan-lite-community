{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://high-archy.tech/schemas/onboard-intake.v1.json",
  "title": "Archytan Lite onboarding intake",
  "description": "The plain facts a client implementation call produces: which roles exist, what each may do, which credentials to provision. Compiled by cmd/onboard into policy.json and callers.json -- see internal/onboard/onboard.go.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actions", "callers"],
  "properties": {
    "version": {
      "const": 1,
      "description": "Format version. Only 1 exists today."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caller" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "allowed_roles"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "allowed_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_per_window": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Required together with window_seconds if either is set."
        },
        "window_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "tenant_match": {
          "type": "boolean",
          "description": "Once true on any action, every caller below must carry a tenant."
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller_id", "role"],
      "properties": {
        "caller_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string" }
      }
    }
  }
}
